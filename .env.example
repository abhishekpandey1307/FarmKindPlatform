# =============================================================================
# FARMKIND — SECURE SERVER & CLIENT ENVIRONMENT CONFIGURATION
# Copy this file to .env and insert your server secret keys.
# =============================================================================

# 1. Server Environment Variables (Configure in Render / local .env)
# Google Gemini API Key for Server-Side Kisan Mitra Voice Reasoning
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Server Port (auto-assigned by Render, defaults to 3001 locally)
PORT=3001

# 2. Frontend Environment Variables (Configure in Vercel)
# Set this in Vercel to your deployed Render backend URL
# Example: https://farmkind-backend.onrender.com
# Leave blank for local development or same-origin proxy
VITE_BACKEND_URL=
